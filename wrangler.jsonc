{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "gpspace",
  "main": "./worker.js",
  "compatibility_date": "2026-09-05",
  "kv_namespaces": [
    { "binding": "GPSPACE_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
