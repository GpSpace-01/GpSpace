{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "gpspace",
  "main": "./worker.js",
  "compatibility_date": "2026-09-05",
  "kv_namespaces": [
    { "binding": "GPSPACE_KV", "id": "29399307e9004f5899c63d515fd1ae23" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/videos/watch/*", "/stories/video/*", "/sitemap.xml"]
  }
}
